{
  "uid": "local-gis",
  "title": "Local GIS",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": {"from": "now-15m", "to": "now"},
  "panels": [
    {
      "id": 1, "title": "Service availability", "type": "timeseries",
      "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "probe_success", "legendFormat": "{{instance}}"}]
    },
    {
      "id": 2, "title": "Probe duration (seconds)", "type": "timeseries",
      "gridPos": {"x": 12, "y": 0, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "probe_duration_seconds", "legendFormat": "{{instance}}"}]
    },
    {
      "id": 3, "title": "Container logs", "type": "logs",
      "gridPos": {"x": 0, "y": 8, "w": 24, "h": 12},
      "datasource": {"type": "loki", "uid": "loki"},
      "targets": [{"refId": "A", "expr": "{service=~\"django|geoserver|martin|titiler|rustfs\"}"}]
    }
  ]
}
