DOCKER_ENV=production
DJANGO_SETTINGS_MODULE=geonode.settings
GEONODE_INSTANCE_NAME=geonode
POSTGRES_USER=postgres
GEONODE_DATABASE=geonode
GEONODE_DATABASE_USER=geonode
GEONODE_GEODATABASE=geonode_data
GEONODE_GEODATABASE_USER=geonode_data
GEONODE_DATABASE_SCHEMA=public
GEONODE_GEODATABASE_SCHEMA=public
DATABASE_HOST=db
BROKER_URL=amqp://guest:guest@rabbitmq:5672/
CELERY__AUTOSCALE_VALUES=4,2
CELERY__HARVESTER_AUTOSCALE_VALUES=2,1
C_FORCE_ROOT=1
CELERY_BEAT_SCHEDULER=celery.beat:PersistentScheduler
ASYNC_SIGNALS=True
SITEURL=${SD_LAB_ORIGIN:-http://localhost:8088}/
ALLOWED_HOSTS="['localhost','127.0.0.1','django','geonode','${SD_LAB_HOST:-localhost}']"
NGINX_BASE_URL=${SD_LAB_ORIGIN:-http://localhost:8088}
GEONODE_LB_HOST_IP=django
GEONODE_LB_PORT=8000
GEOSERVER_LB_HOST_IP=geoserver
GEOSERVER_LB_PORT=8080
GEOSERVER_LOCATION=http://geoserver:8080/geoserver/
GEOSERVER_PUBLIC_LOCATION=${SD_LAB_ORIGIN:-http://localhost:8088}/geoserver/
GEOSERVER_WEB_UI_LOCATION=${SD_LAB_ORIGIN:-http://localhost:8088}/geoserver/
GEOSERVER_ADMIN_USER=admin
GEOSERVER_JAVA_OPTS=-Djava.awt.headless=true -Xms256m -Xmx1536m -Dgwc.context.suffix=gwc -DGEOSERVER_CSRF_WHITELIST=localhost,127.0.0.1,${SD_LAB_HOST:-localhost} -DALLOW_ENV_PARAMETRIZATION=true
DEFAULT_BACKEND_DATASTORE=datastore
DEFAULT_BACKEND_UPLOADER=geonode.importer
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.invalid
EMAIL_ENABLE=False
ACCOUNT_OPEN_SIGNUP=False
DEBUG=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
STATIC_ROOT=/mnt/volumes/statics/static/
MEDIA_ROOT=/mnt/volumes/statics/uploaded/
ASSETS_ROOT=/mnt/volumes/statics/assets/
GEONODE_CLIENT_LAYER_PREVIEW_LIBRARY=mapstore
MEMCACHED_ENABLED=False
INVOKE_LOG_STDOUT=false
